template <>
bool fromYaml<std::u32string>(ryml::ConstNodeRef const& yaml, std::u32string& type, ryml::Parser const& parser)
{
	YamlException::throwIfNoValue(yaml, parser);

	std::string str;
	fromYaml<std::string>(yaml, str, parser);

	utf8::utf8to32(str.begin(), str.end(), std::back_inserter(type));

	return true;
}

