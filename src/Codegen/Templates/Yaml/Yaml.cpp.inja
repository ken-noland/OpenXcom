namespace OpenXcom {

// A lightweight assertion handler that collects an error message via operator<<.
// TODO: Move this to a common header file.
// TODO: Add more context(like current file being parsed) to the error message.
class YamlAssertHandler
{
public:
	// If 'active' is true, the assertion failed.
	YamlAssertHandler(bool active, const char* expr, const char* file, int line)
		: m_active(active), m_expr(expr), m_file(file), m_line(line) {}

	// When the handler is destroyed, if it is active, print the message and abort.
	~YamlAssertHandler()
	{
		if (m_active)
		{
			std::cerr << "Assertion failed: " << m_expr
					  << ", file " << m_file << ", line " << m_line << ". ";
			if (!m_ss.str().empty())
				std::cerr << m_ss.str();
			std::cerr << std::endl;
			std::abort();
		}
	}

	// Allow streaming additional message text.
	template <typename T>
	YamlAssertHandler& operator<<(const T& value)
	{
		if (m_active)
		{
			m_ss << value;
		}
		return *this;
	}

private:
	bool m_active;
	const char* m_expr;
	const char* m_file;
	int m_line;
	std::ostringstream m_ss;
};

#define YAML_ASSERT_MSG(condition) \
	YamlAssertHandler(!(condition), #condition, __FILE__, __LINE__)

// helper function to handle reading optional and required values
template <class Type, bool optional>
bool readYaml(ryml::ConstNodeRef const& yaml, const std::string& key, Type& object)
{
	// check if key is valid
	bool hasKey = yaml.has_child(key.data());

	if constexpr (!optional) // Required key: must exist.
	{
		YAML_ASSERT_MSG(hasKey) << "Missing required key: " << key;

		// Look up the child node with the provided key.
		ryml::ConstNodeRef node = yaml[key.c_str()];

		return fromYaml<Type>(node, object);
	}
	else // Optional key: check for existence.
	{
		if (hasKey)
		{
			// Look up the child node with the provided key.
			ryml::ConstNodeRef node = yaml[key.c_str()];

			return fromYaml<Type>(node, object);
		}
		// we're returning true because the key is optional, even though it wasn't found
		return true;	
	}
}


