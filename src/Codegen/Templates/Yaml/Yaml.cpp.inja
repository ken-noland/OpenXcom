template <>
bool fromYaml<std::u32string>(ryml::ConstNodeRef const& yaml, std::u32string& type)
{
	YAML_ASSERT_MSG(yaml.has_val());

	std::string str;
	fromYaml<std::string>(yaml, str);

	utf8::utf8to32(str.begin(), str.end(), std::back_inserter(type));

	return true;
}

