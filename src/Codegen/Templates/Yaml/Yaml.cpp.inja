template <>
bool fromYaml<std::string>(ryml::ConstNodeRef const& yaml, std::string& type)
{
	YAML_ASSERT_MSG(yaml.has_val());
	ryml::csubstr str(yaml.val());
	type = std::string(str.begin(), str.end());
	return true;
}

