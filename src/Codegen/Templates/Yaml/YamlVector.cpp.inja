// BEGIN YamlVector.cpp.inja

template<>
bool OpenXcom::fromYaml<{{type.fullName}}>(ryml::ConstNodeRef const& yaml, {{type.fullName}}& object)
{
	//ensure the node type is "sequence"
	YAML_ASSERT_MSG(yaml.is_seq()) << "Expected sequence type";

	object.clear();
	object.reserve(yaml.num_children());

	// Iterate over each element in the sequence
	for (ryml::ConstNodeRef child : yaml.children())
	{
		{{type.fullName}}::value_type value;
		if (!fromYaml(child, value))
		{
			return false;
		}
		object.push_back(value);
	}

	return true;
}

template<>
bool OpenXcom::toYaml<{{type.fullName}}>(const {{type.fullName}}& object, ryml::NodeRef& yaml)
{
	return false;
}

// END YamlVector.cpp.inja
