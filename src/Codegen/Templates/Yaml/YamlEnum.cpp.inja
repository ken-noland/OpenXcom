template<>
bool OpenXcom::fromYaml<{{type.fullName}}>(ryml::ConstNodeRef const& yaml, {{type.fullName}}& object, YamlContext& context)
{
	YamlException::throwIfNoValue(yaml, context);

	ryml::csubstr str(yaml.val());
	std::string strValue = std::string(str.begin(), str.end());

	{% for value in type.values %}if(strValue == "{{value.name}}") { object = {{type.fullName}}::{{value.name}}; return true; }
	else {% endfor %}{
		throw YamlException(yaml, context, "Invalid value for {{type.fullName}}.");
	}

	return true;
}

template<>
bool OpenXcom::toYaml<{{type.fullName}}>(const {{type.fullName}}& object, ryml::NodeRef& yaml)
{
	return false;
}

