template<>
bool OpenXcom::fromYaml<{{type.fullName}}>(ryml::ConstNodeRef const& yaml, {{type.fullName}}& object, YamlContext& context)
{
	//ensure the node type is "map"
	if (!yaml.is_map()) { throw OpenXcom::YamlException(yaml, context, "Expected map type."); }

	{% for property in type.properties %}if(!OpenXcom::readYaml<{{property.fulltype}}, {{property.optional}}>(yaml, "{{property.name}}", object.{{property.name}}, context)) { return false; }
	{% endfor %}
	return true;
}

template<>
bool OpenXcom::toYaml<{{type.fullName}}>(const {{type.fullName}}& object, ryml::NodeRef& yaml)
{
	return false;
}

