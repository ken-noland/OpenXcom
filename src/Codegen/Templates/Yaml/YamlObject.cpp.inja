template<>
bool OpenXcom::fromYaml<{{type.fullName}}>(ryml::ConstNodeRef const& yaml, {{type.fullName}}& object)
{
	//ensure the node type is "map"
	YAML_ASSERT_MSG(yaml.is_map()) << "Expected map type";

	{% for property in type.properties %}if(!OpenXcom::readYaml<{{property.fulltype}}, {{property.optional}}>(yaml, "{{property.name}}", object.{{property.name}})) { return false; }
	{% endfor %}
	return true;
}

template<>
bool OpenXcom::toYaml<{{type.fullName}}>(const {{type.fullName}}& object, ryml::NodeRef& yaml)
{
	return false;
}

